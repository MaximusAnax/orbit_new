  "abbreviations": ["Inc.", "Corp.", "Co.", "Ltd.", "L.P.", "plc.", "U.S.", "U.K.", "U.N.", "E.U.", "Mr.", "Mrs.", "Ms.", "Dr.", "Prof.", "Sr.", "Jr.", "St.", "No.", "vs.", "etc.", "e.g.", "i.e.", "approx.", "est.", "a.m.", "p.m.", "Q1.", "Q2.", "Q3.", "Q4.", "Fig.", "Sec.", "Reg."],

